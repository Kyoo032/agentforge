# DPSBuddy hosted web app - environment template.
# Copy to .env next to this file and fill it in. NEVER commit .env, and never put a
# real key in this file.
#
#   cp .env.example .env
#
# Every name below is read by code in this repo. Values marked (required) must be set.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# (required) Public hostname Caddy serves and obtains a certificate for. Used by Caddyfile.
DPSBUDDY_DOMAIN=dpsbuddy.example.com

# (required) Node mode. server.ts serves apps/web/dist statically only when this is
# "production"; anything else starts the Vite dev middleware.
NODE_ENV=production

# Port the Express host listens on, inside the container, on the BIND_HOST interface
# (apps/web/server.ts:114-115 via apps/web/lib/bind-host.ts).
PORT=3000

# ---------------------------------------------------------------------------
# Data and secrets
# ---------------------------------------------------------------------------

# (required) Root of all persistent state: agentforge.sqlite, settings.enc, media,
# logs/, components/. Read by packages/db/src/vault-key.ts localDataDir() and by
# packages/host. Must point at the mounted volume.
AGENTFORGE_DATA_DIR=/data

# (required) 32-byte hex wrap key for settings.enc and sealed prompts
# (packages/db/src/vault-key.ts getLocalVaultKey). Generate once, then keep it forever:
#   openssl rand -hex 32
# If it is unset the host writes /data/.master-key instead; if it CHANGES, settings.enc
# can no longer be decrypted and is moved aside as settings.enc.unreadable.
AGENTFORGE_SECRETS_KEY=

# Overrides the settings file location (a .json/.enc path, or a directory). Leave unset:
# AGENTFORGE_DATA_DIR already places it. Read by vault-key.ts and packages/host.
# AGENTFORGE_SETTINGS_PATH=

# SQLite only. Unset means <AGENTFORGE_DATA_DIR>/agentforge.sqlite. A file: URL picks a
# different file. A postgres:// URL throws on boot - Postgres is an open decision, not
# supported (vault-key.ts:22-27).
# DATABASE_URL=

# Committed drizzle migrations folder. Unset resolves to ../../packages/db/drizzle from
# the process cwd, which is correct in this image (ensure-schema.ts migrationsFolder()).
# AGENTFORGE_MIGRATIONS_DIR=

# Where uploaded/generated media is written. Defaults under the data dir.
# MEDIA_ROOT=/data/media

# ---------------------------------------------------------------------------
# Runtime and gateway
# ---------------------------------------------------------------------------

# "ai" or "stub". "ai" forces the real model path even before a key is saved in
# Settings; "stub" answers without calling a model AND disables the component
# installer's auto-download (packages/host/src/components/status.ts:51).
# Leave unset for the normal behaviour: gateway-first once a key exists.
# AGENTFORGE_RUNTIME=ai

# Toko Token gateway base URL and display name. Defaults live in packages/core; set only
# to point a staging deployment somewhere else.
# AGENTFORGE_GATEWAY_URL=https://api.tokotokenai.com/v1
# AGENTFORGE_GATEWAY_NAME=

# Product name shown in the UI (packages/core). Leave unset for the default.
# AGENTFORGE_PRODUCT_NAME=

# Default UI locale (packages/host). Leave unset to use the saved setting.
# AGENTFORGE_LOCALE=

# ---------------------------------------------------------------------------
# Optional model / tool keys
#
# IGNORED ON THIS DEPLOYMENT. With AGENTFORGE_SERVER=1 (set in compose.yml) the
# provider keys below are refused as a fallback: they are the operator's
# credentials, and every tenant that had not saved its own key would spend them
# (Phase 4, resolveProviderKeys in packages/core/src/secrets.ts). Each tenant
# supplies its own gateway key through onboarding or Settings, sealed under
# AGENTFORGE_SECRETS_KEY in that tenant's own tenant_state row.
#
# They are kept here because the same file is used for local, non-server runs,
# where they still work as the documented headless fallback.
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_BASE_URL=
# ARK_API_KEY=
# ARK_BASE_URL=

# ---------------------------------------------------------------------------
# Media tooling and caches (optional)
# ---------------------------------------------------------------------------

# Absolute paths to ffmpeg/ffprobe if the Edit desk should transcode on the server.
# Neither binary is in the image today - Edit export stays degraded until one is.
# AGENTFORGE_FFMPEG_PATH=
# AGENTFORGE_FFPROBE_PATH=

# ASR model id used by Edit (packages/host/src/edit).
# AGENTFORGE_EDIT_ASR_MODEL=

# Override the model-catalogue cache files. Defaults sit under the data dir.
# AGENTFORGE_MODELS_CACHE_PATH=
# AGENTFORGE_MODELS_DEV_CACHE_PATH=

# Seed media for the Edit starters / video examples. Desktop-pack concerns; unset here.
# AGENTFORGE_STARTER_MEDIA_DIR=
# AGENTFORGE_VIDEO_EXAMPLES_DIR=

# ---------------------------------------------------------------------------
# Secrets Manager (Tencent Cloud SSM) - production
#
# On the CVM the two secrets below are NEVER written to this file. deploy.sh fetches
# them with the CVM instance role (`tccli ssm get-secret-value`) and exports them into
# the compose environment for the lifetime of that one command. Leave
# AGENTFORGE_SECRETS_KEY and BACKUP_KEY EMPTY in .env on the server. Security spec S2,
# S6; placement doc section 3.
# ---------------------------------------------------------------------------

# 1 = fetch the secrets from Secrets Manager with the instance role.
# 0 or unset = read them from this .env (local and staging only).
USE_SSM=0

# Secret NAMES in SSM, never values. Each holds one plaintext string.
SSM_SECRET_AGENTFORGE_SECRETS_KEY=dpsbuddy/prod/agentforge-secrets-key
SSM_SECRET_BACKUP_KEY=dpsbuddy/prod/backup-key

# Version stage to read. Tencent's name for the current value.
SSM_VERSION_STAGE=SSMCurrent

# Region for SSM, COS and the CVM. Personal data stays in Jakarta (placement doc
# section 1); ap-singapore is the backup-replica region only.
TENCENT_REGION=ap-jakarta

# Passphrase for `openssl enc -aes-256-cbc -pbkdf2` over the backup tarball (spec S6).
# Generate once with `openssl rand -hex 32`, store it in SSM under the name above, and
# keep it somewhere other than this server - the tarball is worthless without it.
# With USE_SSM=1 leave this empty.
BACKUP_KEY=

# COS buckets, "<name>-<appid>" exactly as the console shows them. Both private, both
# SSE-KMS (spec S5). The backup bucket has versioning on and a lifecycle to ARCHIVE
# after 30 days, delete after 365.
COS_BACKUP_BUCKET=dpsbuddy-backup-1300000000
COS_MEDIA_BUCKET=dpsbuddy-media-1300000000

# Key prefix inside the backup bucket. backup.sh appends the file name.
COS_BACKUP_PREFIX=hourly/

# ---------------------------------------------------------------------------
# Object storage for tenants' media (migration plan Phase 6;
# docs/internal/web-phase6-tenant-storage.md, docs/internal/tencent-cvm-setup.md section 12)
#
# Which backend holds a tenant's bytes. `file` (the default, and anything unrecognised)
# keeps the per-tenant directories Phase 3 lane D placed under the data dir; `cos` puts
# them in COS_MEDIA_BUCKET above, keyed with the same `tenants/<id>/` prefixes.
#
# This is a SEPARATE switch from AGENTFORGE_SERVER on purpose: a hosted box without a
# bucket is a real deployment, and tying the two together would break it on upgrade. Turn
# it on only once the bucket exists AND the existing media/ tree has been copied into it —
# nothing migrates it for you, and a key that is not in the bucket answers 404.
#
# With `cos` set and the bucket or the credentials missing, the app REFUSES rather than
# writing to the disk. That is deliberate: a silent fall back to a directory nobody backs
# up is how a tenant's uploads disappear.
# ---------------------------------------------------------------------------
AGENTFORGE_STORAGE=file

# Credentials. On the CVM leave BOTH empty and set COS_CAM_ROLE instead: the instance role
# hands out temporary credentials through the metadata service, which is what the security
# spec's S2 wants instead of a long-lived key pair on the box. A static pair is for local
# and staging only.
COS_SECRET_ID=
COS_SECRET_KEY=
# Only with a temporary credential supplied by hand; the CAM path fetches its own.
COS_SESSION_TOKEN=

# The CAM role attached to the CVM (console: Cloud Virtual Machine > the instance > Role).
# It needs PutObject, GetObject, HeadObject, DeleteObject and GetBucket on the media bucket.
COS_CAM_ROLE=

# Override the endpoint only for a stub or a private-link address. Must be https://.
# Default: https://<COS_MEDIA_BUCKET>.cos.<TENCENT_REGION>.myqcloud.com
# COS_ENDPOINT=

# Per-tenant storage ceiling in BYTES, counted across the bucket and the on-disk job trees
# (ffmpeg scratch, dataset files). Default 21474836480 (20 GiB). `0`, `off`, `none` or
# `unlimited` switches it off; junk falls back to the DEFAULT rather than to unlimited, so
# a typo can never quietly remove the ceiling. Server mode only: a desktop is never limited.
# A write over the ceiling answers 403 storage_quota_exceeded, and the tenant can still read
# GET /api/v1/storage/usage to see what to delete.
AGENTFORGE_TENANT_STORAGE_BYTES=21474836480

# ---------------------------------------------------------------------------
# Hosted mode (migration plan Phase 1 and 2; security spec A1, A2, N5, S1, T4, T8, T9, L1)
# ---------------------------------------------------------------------------

# The one switch for every hosted-only rule (packages/core/src/server-mode.ts): web Origin
# allowlist instead of loopback, CSRF token on every mutating call, mandatory wrap key,
# gate fails closed, "Start over" refused, session required on mutating /api.
# Webdev and the desktop never set it.
AGENTFORGE_SERVER=1

# Comma-separated origins allowed to make mutating /api calls (scheme://host[:port]).
# Empty in server mode = no browser can write. The Host header must match one of these too,
# so the reverse proxy has to forward Host UNCHANGED (no `header_up Host` in the Caddyfile);
# a rewritten or loopback Host answers 403 origin_forbidden. The second half of the check is
# the CSRF cookie the app sets itself (__Host-agentforge_csrf over TLS) and the renderer
# echoes in x-agentforge-csrf; no proxy configuration is involved in that one.
AGENTFORGE_TRUSTED_ORIGINS=https://dpsbuddy.example.com

# Interface the Express host binds. Keep loopback behind the proxy in the same network
# namespace (compose.yml); a non-loopback bind is refused unless AGENTFORGE_SERVER=1.
BIND_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Transport filtering (security spec A4, N3; "masked HTTPS and HTTP filtering")
#
# All of this is server-mode only. Webdev and the desktop are unlimited and unfiltered.
#
# Two headers the reverse proxy MUST keep sending, both Caddy defaults:
#   X-Forwarded-Proto: https - every request without it answers 403 https_required, which
#     is what makes a direct hit on 127.0.0.1:3000 from inside the box useless.
#   X-Forwarded-For - the LAST hop, the one Caddy itself appended, is the client IP the limiters key on; a client-supplied X-Forwarded-For prefix is ignored. With no proxy
#     in front, every request would key on the socket address and share one bucket.
#
# Token buckets in memory (packages/host/src/rate-limit.ts), per client, bounded at 50k
# keys with LRU eviction. Over the limit answers 429 rate_limited with Retry-After in
# seconds. Set a value to 0 to switch that bucket off; junk falls back to the default, so
# a typo can never quietly remove a limit.
# ---------------------------------------------------------------------------

# Sustained requests per minute per client IP (burst 100).
AGENTFORGE_RATE_IP_RPM=600

# Sustained requests per minute per browser session, keyed on a hash of the session
# cookie so one account cannot spread a flood over many addresses (burst 50).
AGENTFORGE_RATE_SESSION_RPM=300

# Tighter per-IP bucket on /api/v1/auth/* (burst 10). Every request there is a portal
# round trip, so it is the one worth paying for; keep it far below the general rate.
AGENTFORGE_RATE_AUTH_RPM=30

# Portal base URL for the browser session exchange (POST /auth/token, /auth/logout).
AGENTFORGE_PORTAL_URL=https://portal.example.com/api

# Global caps until per-tenant caps land (spec T9). Queue depth is 4x; overflow answers
# 429 too_many_jobs.
AGENTFORGE_MAX_FFMPEG=2
AGENTFORGE_MAX_SQL_WORKERS=4
# A queued job waits this long for a slot before it answers 429 too_many_jobs.
AGENTFORGE_JOB_QUEUE_TIMEOUT_MS=60000

# Host log level for the JSON logger (packages/host/src/log.ts): debug | info | warn | error.
AGENTFORGE_LOG_LEVEL=info
# ---------------------------------------------------------------------------
# Do NOT set
# ---------------------------------------------------------------------------
# AGENTFORGE_APPLY_PENDING_RESET - set by apps/web/server-env.ts at boot to apply a
#   queued "Start over" wipe. Setting it by hand can delete the data dir.
# AGENTFORGE_PACKAGED - Electron packaging marker. Desktop only.
