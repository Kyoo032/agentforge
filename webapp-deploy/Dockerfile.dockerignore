# Build context is the repo root. Keep it small: node_modules is ~1.1 GB, .git ~243 MB.
#
# IMPORTANT: BuildKit looks for `<dockerfile-path>.dockerignore` first and only then for
# `<context>/.dockerignore`. Because the Dockerfile lives in webapp-deploy/ while the
# context is the repo root, the file Docker actually reads is
# webapp-deploy/Dockerfile.dockerignore. There is no root .dockerignore; this is the only one.

.git
.github
.gitattributes
**/node_modules
**/dist
**/.next
**/.turbo
**/out
**/coverage
**/playwright-report
**/test-results
**/*.tsbuildinfo

# Local state and secrets - never in an image. Patterns without `**/` match only at
# the repo root; apps/web/.env.local and .webdev-data-*/.master-key were both
# missed before 2026-09-23 (SR-49). The archive-from-sha release path is the
# real guard; this list is the second one.
**/.env
**/.env.*
!**/.env.example
**/data
.webdev-data*
**/*.enc
**/.master-key
**/*.sqlite
**/*.sqlite-*
.verify-*
.cursor-artifacts
.claude
.cursor
.vscode
**/*.log

# Frozen desktop / mobile: the hosted app never builds these
apps/desktop/dist
apps/desktop/dist-*
apps/desktop/out
apps/desktop/resources
apps/desktop/branding
apps/mobile/android
apps/mobile/ios

# Docs and scratch
_ref
docs
webapp-deploy/.env
