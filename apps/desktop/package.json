{
  "name": "@agentforge/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Agentforge. Starts the local Next app on 127.0.0.1:3000.",
  "main": "main.cjs",
  "scripts": {
    "desktop-dev": "electron .",
    "desktop-build": "pnpm --filter @agentforge/web build && electron-builder --win nsis",
    "desktop-build-dir": "electron-builder --win nsis --dir"
  },
  "dependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tokotoken.agentforge",
    "productName": "Agentforge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "splash/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
