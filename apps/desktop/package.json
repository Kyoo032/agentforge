{
  "name": "@agentforge/desktop",
  "version": "0.14.23",
  "private": true,
  "description": "Electron shell for Agentforge. Packaged builds use IPC (no loopback HTTP server).",
  "main": "main.cjs",
  "scripts": {
    "desktop-dev": "electron .",
    "desktop-build": "node ../../scripts/edit-starters.mjs --check && node ../../scripts/video-examples.mjs --check && pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && node scripts/pack-brand.mjs",
    "desktop-build-all": "node scripts/pack-all-brands.mjs",
    "desktop-pack": "node scripts/pack-brand.mjs",
    "desktop-release": "node scripts/release-desktop.mjs",
    "desktop-build-dir": "pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && electron-builder --win nsis --dir",
    "desktop-build-mac": "pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && node scripts/pack-brand.mjs --restore-public && electron-builder --mac",
    "desktop-build-mac-dir": "pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && node scripts/pack-brand.mjs --restore-public && electron-builder --mac --dir",
    "desktop-build-mac-docker": "node scripts/mac-build-docker.mjs",
    "desktop-mac": "node scripts/macos-app.mjs",
    "desktop-build-linux": "pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && electron-builder --linux",
    "desktop-build-linux-dir": "pnpm --filter @agentforge/web build && node scripts/stage-renderer.mjs && electron-builder --linux --dir",
    "rebuild-natives": "echo 'Run on the target OS, never Cloud (macOS: once per arch): npx @electron/rebuild -f -w better-sqlite3 -w keytar'",
    "test": "node brand-read.test.cjs && node auto-update.test.cjs && node edit-menu.test.cjs && node lifecycle.test.cjs && node scripts/release-artifacts.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.9"
  },
  "build": {
    "appId": "com.tokotoken.agentforge",
    "productName": "Agentforge",
    "extraMetadata": {
      "name": "agentforge"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Agentforge Setup ${version}.${ext}",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "brand-read.cjs",
      "auto-update.cjs",
      "edit-menu.cjs",
      "lifecycle.cjs",
      "host.cjs",
      "splash/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/renderer",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "resources/drizzle",
        "to": "drizzle"
      },
      {
        "from": "resources/brand",
        "to": "brand"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "resources/starters",
        "to": "starters",
        "filter": [
          "*.mp4",
          "*.m4a",
          "README.md"
        ]
      },
      {
        "from": "resources/examples/videos",
        "to": "examples/videos",
        "filter": [
          "*.mp4",
          "README.md"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/keytar/**"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "identity": null,
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Agentforge-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Kyoo032",
      "repo": "DPS-Agent-Platform",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    }
  }
}
