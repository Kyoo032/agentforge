{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentforge",
  "version": "0.1.0",
  "identifier": "com.tokotoken.agentforge",
  "build": {
    "beforeDevCommand": "pnpm --filter @agentforge/web dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm --filter @agentforge/web build",
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentforge",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
