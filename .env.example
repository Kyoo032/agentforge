# Product default is SQLite at data/agentforge.sqlite (created on first open / db:push).
# Leave DATABASE_URL unset. Postgres is not supported in closed beta.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tokotokenai.com/v1
GOOGLE_GENERATIVE_AI_API_KEY=
MEDIA_ROOT=./data/media
AGENTFORGE_RUNTIME=stub
# Optional wrap key for settings.enc and sealed prompts.
# Desktop (Electron): keytar stores this in the OS keychain and injects it.
# Webdev: if unset, data/.master-key is created (and copied into the keychain when keytar works).
AGENTFORGE_SECRETS_KEY=
