{
  "name": "agentforge",
  "private": true,
  "description": "Closed-beta local workbench for the Toko Token AI gateway",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false .",
    "lint:fix": "biome check --write .",
    "test:e2e": "pnpm --filter @agentforge/web test:e2e",
    "db:push": "pnpm --filter @agentforge/db push",
    "db:seed": "pnpm --filter @agentforge/db seed",
    "db:studio": "pnpm --filter @agentforge/db studio",
    "edit:starters": "node scripts/edit-starters.mjs",
    "edit:starters:check": "node scripts/edit-starters.mjs --check",
    "videos:examples": "node scripts/video-examples.mjs",
    "videos:examples:check": "node scripts/video-examples.mjs --check",
    "desktop:dev": "pnpm --filter @agentforge/desktop desktop-dev",
    "desktop:build": "pnpm --filter @agentforge/desktop desktop-build",
    "desktop:release": "pnpm --filter @agentforge/desktop desktop-release",
    "desktop:build:all": "pnpm --filter @agentforge/desktop desktop-build-all",
    "desktop:build:mac": "pnpm --filter @agentforge/desktop desktop-build-mac",
    "desktop:build:mac:dir": "pnpm --filter @agentforge/desktop desktop-build-mac-dir",
    "desktop:build:mac:docker": "pnpm --filter @agentforge/desktop desktop-build-mac-docker",
    "desktop:mac": "node apps/desktop/scripts/macos-app.mjs",
    "desktop:build:linux": "pnpm --filter @agentforge/desktop desktop-build-linux"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
