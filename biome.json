{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!**/.cursor",
      "!!**/packages/db/drizzle",
      "!!**/apps/desktop/resources",
      "!!**/apps/desktop/host.cjs",
      "!!**/apps/web/app",
      "!!**/pnpm-lock.yaml"
    ]
  },
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "crlf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "recommended": false
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnsafeOptionalChaining": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noUndeclaredEnvVars": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
