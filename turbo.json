{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AGENTFORGE_RUNTIME",
    "AGENTFORGE_DATA_DIR",
    "AGENTFORGE_PRODUCT_NAME",
    "AGENTFORGE_GATEWAY_NAME",
    "AGENTFORGE_GATEWAY_URL",
    "AGENTFORGE_SECRETS_KEY",
    "AGENTFORGE_VERIFY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AGENTFORGE_RUNTIME",
        "AGENTFORGE_DATA_DIR",
        "AGENTFORGE_PRODUCT_NAME",
        "AGENTFORGE_GATEWAY_NAME",
        "AGENTFORGE_GATEWAY_URL",
        "AGENTFORGE_SECRETS_KEY"
      ]
    },
    "test": {}
  }
}
