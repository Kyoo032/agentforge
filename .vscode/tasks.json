{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify-installed-exe",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "if (-not (Test-Path 'C:\\Program Files\\Nultron\\Nultron.exe')) { throw 'Installed Nultron.exe missing' }; (Get-Item 'C:\\Program Files\\Nultron\\Nultron.exe').VersionInfo.ProductVersion"
      ],
      "problemMatcher": []
    },
    {
      "label": "verify-macos-app",
      "type": "shell",
      "command": "node",
      "args": ["apps/desktop/scripts/macos-app.mjs", "--check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
